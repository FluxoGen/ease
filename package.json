{
  "name": "ease",
  "private": true,
  "version": "1.0.0",
  "description": "Ease — a symptom-first self-acupressure PWA (React + Vite + TypeScript). Wellness education only.",
  "author": "FluxoGen",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/FluxoGen/ease.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --port 5183",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview --port 4173",
    "check": "python3 scripts/check_library.py && node scripts/contrast_check.mjs",
    "build:native": "tsc -b && vite build --mode native",
    "android": "npm run build:native && cap sync android && cap open android",
    "android:sync": "npm run build:native && cap sync android",
    "qa:install": "npm --prefix qa install",
    "qa:web": "npm --prefix qa run web",
    "qa:app": "npm --prefix qa run app",
    "qa:android": "npm --prefix qa run android"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capawesome/capacitor-app-update": "^8.1.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@headlessui/react": "^2.2.10",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  },
  "config": {
    "androidVersionCode": 1
  }
}
